{
	"name": "novacode",
	"version": "0.12.3",
	"description": "Open-source multi-provider coding agent.",
	"type": "module",
	"main": "./dist/main.mjs",
	"bin": {
		"nova": "dist/main.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"start": "node dist/main.mjs",
		"dev": "node --import tsx/esm --watch src/main.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"check": "npm run build && npm run typecheck && npm run lint && npm test",
		"benchmark": "node --import tsx/esm test/benchmark.ts",
		"sandbox": "./scripts/sandbox/install.sh"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"cli",
		"agent",
		"llm",
		"nova",
		"novacode"
	],
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rwitesh/novacode.git"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/semver": "^7.8.0",
		"lefthook": "^2.1.16",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.71",
		"@ai-sdk/google": "^4.0.87",
		"@ai-sdk/openai": "^4.0.83",
		"ai": "^7.0.127",
		"chalk": "^6.0.1",
		"glob": "^13.0.6",
		"ink": "^8.0.0",
		"ink-big-text": "^2.0.0",
		"react": "^19.3.0",
		"semver": "^7.8.5",
		"strip-ansi": "^7.2.0",
		"zod": "^4.6.5"
	}
}
